{
  "name": "assets",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build -w --mode development",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write --config .prettierrc src/**/*.{css,js,svelte}",
    "format:check": "prettier --check --config .prettierrc src/**/*.{css,js,svelte}",
    "lint": "svelte-check --tsconfig ./tsconfig.json && eslint src",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@popperjs/core": "^2.11.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "happy-dom": "^21.0.4",
    "jscpd": "^5.0.14",
    "knip": "^6.32.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.7.2",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.3.3",
    "vite-plugin-static-copy": "^3.4.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "bootstrap": "^5.3.5",
    "bootstrap-icons": "^1.11.3"
  },
  "packageManager": "yarn@4.12.0"
}
