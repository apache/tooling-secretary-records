htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
coverage.json
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
# vitest's json-summary, read by the frontend-coverage meter
assets/coverage/

# Screenshots
screenshots/

# Translations
*.mo
*.pot

# pyenv
.python-version

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Environments
.venv
.env
.env*

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ruff
.ruff_cache/

# PyCharm
.idea/

# VSCode related IDE files
.vscode/

# macOS stuff
.DS_Store

# ignore vim swp files
*.swp

app/client/static/assets

# puppet provisioned config
config.yaml

# new app token hotness
apptoken.txt

# app runtime state directory
state/

# e2e (Playwright) server state directory
state-e2e/

# ignore pem files
*.pem

# ignore emacs backup files
*~

# Ignore Pipfile* generated by pipservice
Pipfile*

# Claude Code. The parts of the harness that belong to the repository rather than to
# whoever is running it are committed: the permission allowlist, the guards that hold
# the AGENTS.md rules, and the commands that stand in for a procedure written out in
# prose. Everything else under .claude/ is personal or scratch - a session's approvals
# accrue in settings.local.json, and each session's linked worktree lives under
# worktrees/ - so the directory is ignored by default and the shared parts opted back in.
.claude/*
!.claude/commands/
!.claude/hooks/
!.claude/settings.json
!.claude/skills/
