[Unit]
Description=ASF Secretary Records

[Service]
Type=exec
WorkingDirectory=/opt/secretary-records
PIDFile=/opt/secretary-records/state/secretary-records.pid
ExecStart=/opt/secretary-records/scripts/run.sh
ExecReload=/bin/kill -SIGINT $MAINPID
KillSignal=SIGINT
Restart=always
User=secretary-records
Group=secretary-records
LogLevelMax=info

[Install]
WantedBy=multi-user.target
