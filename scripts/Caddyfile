# https://localhost in front of the app on https://localhost:4500, started by `make dev`.
#
# ASF OAuth refuses a redirect URI that carries a port, and the app builds that URI from the
# host the browser used, so signing in only works at https://localhost. The proxy passes the
# host through unchanged. It is run from the repository root, with the certificate `make certs`
# made for the app; the app's own certificate is not verified, being on this machine.
{
	auto_https off
	admin off
}

https://localhost {
	tls state/cert.pem state/key.pem
	reverse_proxy https://localhost:4500 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}
